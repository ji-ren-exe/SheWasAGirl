# =====================
# Unity / Tuanjie .gitignore
# =====================

# Build outputs
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Uu]ser[Ss]ettings/
/[Ll]ogs/
/[Bb]uilds-*

# MemoryCaptures
/[Mm]emoryCaptures/

# Recordings
/[Rr]ecordings/

# Autogenerated Crash Reports
sysinfo.txt
crashlytics-build.properties

# Asset Store
/[Aa]ssets/AssetStoreTools*
/Assets/Plugins/Editor/JetBrains*

# Visual Studio / IDE cache
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.userosscache
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.sln.docstates

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Files generated by Codely CLI
/.codely-cli/
/.codely.packages/
/.com-unity-codely.json

# Tool private directories
.workbuddy/

# Large source files
*.psd
*.ai
*.wav
*.mp3

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Keep source references of 2D-Platform-Controller
/2D-Platform-Controller-main/
